{
  "name": "dreamgrove",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env NODE_OPTIONS='--disable-warning=DEP0040' INIT_CWD=$PWD next build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules --disable-warning=DEP0040 --disable-warning=ExperimentalWarning' node ./scripts/postbuild.mjs",
    "populate-spells": "cross-env NODE_OPTIONS='--disable-warning=ExperimentalWarning' node ./scripts/populate-spell-db.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix app components lib layouts scripts",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:mdx": "node --no-warnings --test __tests__/plugins/remarkSafeMdx.test.mjs",
    "check:mdx": "node --no-warnings scripts/check-mdx.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@headlessui/react": "^2.2.10",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@mdx-js/mdx": "^3.1.1",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/codemirror-theme-darcula": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "contentlayer2": "0.5.4",
    "esbuild": "0.25.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "js-yaml": "^4.3.2",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "next-contentlayer2": "0.5.4",
    "next-themes": "^0.4.6",
    "nextstepjs": "^2.3.0",
    "node-fetch": "^2.7.0",
    "octokit": "^4.1.4",
    "plaiceholder": "^3.0.0",
    "postcss": "^8.5.32",
    "probe-image-size": "^7.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-youtube": "^10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.3.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.2.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/jest": "^29.5.14",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "overrides": {
    "@types/react": "$@types/react"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "contentlayer2",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.15"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react-virtual>react": "19"
      }
    }
  }
}
